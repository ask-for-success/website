Project AFS_Database {
  database_type: 'PostgreSQL'
  Note: 'Ask For Success - Public website, recruitment, member platform, and internal management'
}

// =====================================================
// TECHNICAL DECISIONS
// =====================================================

// PostgreSQL is the selected database engine.
// Public and internal identifiers use UUID values.
// The PostgreSQL citext extension enforces case-insensitive email uniqueness.
// Secrets, uploaded files, and sensitive documents are never stored directly in the database.
// The database stores only metadata and object-storage keys.
//
// Django creates and manages its own technical tables, including:
// - django_migrations
// - django_content_type
// - django_session
// - auth_group
// - auth_permission
// - user, group, and permission junction tables
//
// Those framework tables are intentionally excluded from this business model.

// =====================================================
// ENUMS
// =====================================================

Enum account_status {
  active
  disabled
}

Enum membership_status {
  onboarding_required
  active
  suspended
}

Enum file_status {
  temporary
  scanning
  available
  rejected
  archived
}

Enum file_type {
  image
  video
  document
  external_link
}

Enum file_confidentiality {
  public
  internal
  sensitive
}

Enum question_type {
  short_text
  long_text
  choice
  date
  file
}

Enum opportunity_status {
  draft
  published
  archived
}

Enum application_status {
  submitted
  under_review
  contacted
  interview
  approved
  rejected
}

Enum membership_request_status {
  submitted
  under_review
  approved
  rejected
}

Enum delivery_status {
  not_required
  pending
  sent
  failed
}

Enum event_status {
  published
  archived
}

Enum registration_approval_mode {
  automatic
  manual
}

Enum registration_source {
  public
  manual
}

Enum registration_status {
  pending
  approved
  rejected
}

Enum qr_status {
  not_required
  pending
  sent
  failed
}

Enum checkin_method {
  qr
  manual
}

Enum reminder_status {
  scheduled
  sent
  failed
}

Enum content_type {
  news
  story
  announcement
}

Enum publication_status {
  published
  archived
}

Enum notification_type {
  announcement
  event
  content
  system
}

Enum donation_type {
  cash
  goods
}

Enum donation_delivery_method {
  drop_off
  pickup
}

Enum donation_status {
  new
  contacted
  confirmed
  received
  declined
}

Enum organization_type {
  school
  company
  association
  other
}

Enum partner_offer_type {
  venue
  internship
  workshop
  sponsorship
  other
}

Enum partner_request_status {
  new
  in_discussion
  accepted
  declined
}

// =====================================================
// MODULE 01 - IDENTITY, ORGANIZATION, AND ACCESS
// =====================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email citext [unique, not null]
  phone varchar(30)
  password_hash varchar(255) [not null]
  status account_status [not null, default: 'active']
  email_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table files {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid
  original_name varchar(255) [not null]
  storage_key varchar(500) [unique]
  external_url varchar(1000)
  type file_type [not null]
  mime_type varchar(150)
  size_bytes bigint
  sha256_hash char(64)
  confidentiality file_confidentiality [not null, default: 'internal']
  status file_status [not null, default: 'temporary']
  created_at timestamptz [not null, default: `now()`]
  scanned_at timestamptz
  archived_at timestamptz

  Note: 'An external link uses external_url. An uploaded file uses storage_key. Identity documents use sensitive confidentiality.'
}

Table departments {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [unique, not null]
  slug varchar(150) [unique, not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table positions {
  id uuid [pk, default: `gen_random_uuid()`]
  department_id uuid [not null]
  name varchar(150) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (department_id, name) [unique]
    (id, department_id) [unique]
  }
}

Table memberships {
  user_id uuid [pk]
  primary_department_id uuid [not null]
  primary_position_id uuid [not null]
  approved_by_id uuid [not null]
  status membership_status [not null, default: 'onboarding_required']
  approved_at timestamptz [not null, default: `now()`]
  onboarding_completed_at timestamptz
  activated_at timestamptz
  suspended_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
}

Table member_profiles {
  user_id uuid [pk]
  birth_date date [not null]
  school_or_university varchar(200) [not null]
  city varchar(100)
  public_title varchar(150)
  profile_picture_id uuid
  identity_document_id uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'The identity document is a protected sensitive file and must never be exposed through a public URL.'
}

// =====================================================
// MODULE 02 - RECRUITMENT AND DIRECT MEMBERSHIP
// =====================================================

Table department_forms {
  id uuid [pk, default: `gen_random_uuid()`]
  department_id uuid [unique, not null]
  created_by_id uuid [not null]
  title varchar(200) [not null]
  locked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, department_id) [unique]
  }

  Note: 'A department form is automatically locked when its first application is submitted.'
}

Table form_questions {
  id uuid [pk, default: `gen_random_uuid()`]
  form_id uuid [not null]
  label text [not null]
  type question_type [not null]
  is_required boolean [not null, default: true]
  sort_order int [not null, default: 0]
  file_rules jsonb
  created_at timestamptz [not null, default: `now()`]
}

Table question_choices {
  id uuid [pk, default: `gen_random_uuid()`]
  question_id uuid [not null]
  value varchar(150) [not null]
  label varchar(200) [not null]
  sort_order int [not null, default: 0]

  indexes {
    (question_id, value) [unique]
  }
}

Table opportunities {
  id uuid [pk, default: `gen_random_uuid()`]
  department_id uuid [not null]
  position_id uuid
  form_id uuid [not null]
  created_by_id uuid [not null]
  title varchar(200) [not null]
  slug varchar(200) [unique, not null]
  description text
  status opportunity_status [not null, default: 'draft']
  opens_at timestamptz
  closes_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  opportunity_id uuid [not null]
  status application_status [not null, default: 'submitted']
  submitted_at timestamptz [not null, default: `now()`]
  review_started_at timestamptz
  decided_by_id uuid
  decided_at timestamptz
  decision_email_status delivery_status [not null, default: 'not_required']
  decision_email_sent_at timestamptz
  decision_email_error text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, opportunity_id) [unique]
    (status, submitted_at)
  }
}

Table application_answers {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null]
  question_id uuid [not null]
  text_value text
  date_value date
  file_id uuid

  indexes {
    (application_id, question_id) [unique]
  }

  Note: 'An answer uses the value column matching its question type. Submitted answers are immutable.'
}

Table hr_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null]
  author_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'HR notes are never exposed to applicants or ordinary members.'
}

Table membership_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  preferred_department_id uuid [not null]
  motivation text [not null]
  status membership_request_status [not null, default: 'submitted']
  submitted_at timestamptz [not null, default: `now()`]
  decided_by_id uuid
  decided_at timestamptz
  decision_email_status delivery_status [not null, default: 'not_required']
  decision_email_sent_at timestamptz
  decision_email_error text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, submitted_at)
    (status, submitted_at)
  }
}

// =====================================================
// MODULE 03 - EVENTS, REGISTRATIONS, AND CHECK-IN
// =====================================================

Table events {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by_id uuid [not null]
  title varchar(200) [not null]
  slug varchar(200) [unique, not null]
  summary text
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  venue varchar(200)
  city varchar(100)
  capacity int
  price numeric(12,2) [not null, default: 0]
  currency char(3) [not null, default: 'MAD']
  cover_file_id uuid
  registration_enabled boolean [not null, default: false]
  registration_opens_at timestamptz
  registration_closes_at timestamptz
  approval_mode registration_approval_mode [not null, default: 'automatic']
  qr_enabled boolean [not null, default: false]
  qr_send_at timestamptz
  status event_status [not null, default: 'published']
  published_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'The start must precede the end. Capacity and price must be non-negative. QR delivery requires event registration to be enabled.'
}

Table event_registrations {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  created_by_id uuid
  source registration_source [not null, default: 'public']
  full_name varchar(150) [not null]
  email citext [not null]
  school_or_university varchar(200) [not null]
  birth_date date [not null]
  city varchar(100) [not null]
  status registration_status [not null, default: 'pending']
  decided_by_id uuid
  decided_at timestamptz
  qr_token_hash char(64) [unique]
  qr_delivery_status qr_status [not null, default: 'not_required']
  qr_sent_at timestamptz
  qr_delivery_error text
  registered_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, email) [unique]
    (event_id, status, registered_at)
  }
}

Table event_checkins {
  id uuid [pk, default: `gen_random_uuid()`]
  registration_id uuid [unique, not null]
  checked_in_by_id uuid [not null]
  method checkin_method [not null]
  checked_in_at timestamptz [not null, default: `now()`]

  Note: 'Only one valid check-in row is allowed for each registration. Repeated scans do not create additional rows.'
}

Table event_checkin_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  user_id uuid [not null]
  granted_by_id uuid [not null]
  granted_at timestamptz [not null, default: `now()`]
  revoked_by_id uuid
  revoked_at timestamptz

  indexes {
    (event_id, user_id, granted_at)
  }

  Note: 'PostgreSQL adds a partial unique index on event_id and user_id when revoked_at is NULL.'
}

Table registration_reminders {
  id uuid [pk, default: `gen_random_uuid()`]
  registration_id uuid [not null]
  reminder_key varchar(50) [not null]
  scheduled_at timestamptz [not null]
  status reminder_status [not null, default: 'scheduled']
  sent_at timestamptz
  error_message text

  indexes {
    (registration_id, reminder_key) [unique]
  }
}

// =====================================================
// MODULE 04 - CONTENT, MEDIA, AND CMS
// =====================================================

Table content_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  sort_order int [not null, default: 0]
}

Table contents {
  id uuid [pk, default: `gen_random_uuid()`]
  author_id uuid [not null]
  category_id uuid [not null]
  cover_file_id uuid
  type content_type [not null]
  title varchar(250) [not null]
  slug varchar(250) [unique, not null]
  summary text
  body text [not null]
  external_url varchar(1000)
  status publication_status [not null, default: 'published']
  published_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)
    (category_id, status, published_at)
  }
}

Table gallery_items {
  id uuid [pk, default: `gen_random_uuid()`]
  file_id uuid [unique, not null]
  event_id uuid
  added_by_id uuid [not null]
  caption text
  is_visible boolean [not null, default: true]
  sort_order int [not null, default: 0]
  added_at timestamptz [not null, default: `now()`]
}

Table page_sections {
  id uuid [pk, default: `gen_random_uuid()`]
  updated_by_id uuid [not null]
  page varchar(50) [not null]
  section_key varchar(100) [not null]
  title varchar(250)
  body text
  media_id uuid
  sort_order int [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (page, section_key) [unique]
  }

  Note: 'Public pages use fixed sections. In V1, Save and Publish immediately replaces the published value.'
}

Table featured_items {
  id uuid [pk, default: `gen_random_uuid()`]
  placement_key varchar(100) [not null]
  content_id uuid
  event_id uuid
  file_id uuid
  sort_order int [not null, default: 0]
  updated_by_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (placement_key, sort_order) [unique]
  }

  Note: 'A featured item references exactly one content item, event, or file.'
}

Table site_statistics {
  id uuid [pk, default: `gen_random_uuid()`]
  label varchar(100) [not null]
  value varchar(50) [not null]
  is_visible boolean [not null, default: true]
  sort_order int [not null, default: 0]
  updated_by_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]
}

Table site_settings {
  id uuid [pk, default: `gen_random_uuid()`]
  setting_key varchar(100) [unique, not null]
  setting_value jsonb [not null]
  description text
  is_public boolean [not null, default: false]
  updated_by_id uuid [not null]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Secrets and credentials are never stored in this table.'
}

Table member_notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by_id uuid [not null]
  event_id uuid
  content_id uuid
  title varchar(200) [not null]
  message text [not null]
  type notification_type [not null, default: 'system']
  link_url varchar(1000)
  sent_at timestamptz [not null, default: `now()`]

  Note: 'V1 broadcasts notifications to all members and does not track read state.'
}

// =====================================================
// MODULE 05 - COMMUNITY ENGAGEMENT
// =====================================================

Table donations {
  id uuid [pk, default: `gen_random_uuid()`]
  handled_by_id uuid
  type donation_type [not null]
  donor_name varchar(150) [not null]
  email citext
  phone varchar(30)
  amount numeric(12,2)
  currency char(3) [default: 'MAD']
  goods_description text
  delivery_method donation_delivery_method
  status donation_status [not null, default: 'new']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'A cash donation requires a positive amount. A goods donation requires a description and delivery method.'
}

Table partners {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  logo_id uuid
  type organization_type
  is_visible boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table partner_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  handled_by_id uuid
  partner_id uuid
  organization_name varchar(200) [not null]
  organization_type organization_type [not null]
  contact_name varchar(150) [not null]
  email citext [not null]
  phone varchar(30)
  offer_type partner_offer_type [not null]
  message text [not null]
  status partner_request_status [not null, default: 'new']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =====================================================
// MODULE 06 - AUDIT
// =====================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid
  action_code varchar(100) [not null]
  target_type varchar(100) [not null]
  target_id varchar(100)
  succeeded boolean [not null, default: true]
  details jsonb
  request_id uuid
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (action_code, created_at)
    (target_type, target_id, created_at)
    (actor_id, created_at)
  }

  Note: 'Append-only audit log. Passwords, tokens, and sensitive documents are excluded from details.'
}

// =====================================================
// RELATIONSHIPS AND DELETION POLICIES
// =====================================================

// Identity and organization
Ref: users.id < files.owner_id [delete: set null]
Ref: departments.id < positions.department_id [delete: restrict]
Ref: users.id - memberships.user_id [delete: restrict]
Ref: departments.id < memberships.primary_department_id [delete: restrict]
Ref: positions.(id, department_id) < memberships.(primary_position_id, primary_department_id) [delete: restrict]
Ref: users.id < memberships.approved_by_id [delete: restrict]
Ref: users.id - member_profiles.user_id [delete: cascade]
Ref: files.id < member_profiles.profile_picture_id [delete: set null]
Ref: files.id < member_profiles.identity_document_id [delete: restrict]

// Recruitment
Ref: departments.id - department_forms.department_id [delete: restrict]
Ref: users.id < department_forms.created_by_id [delete: restrict]
Ref: department_forms.id < form_questions.form_id [delete: restrict]
Ref: form_questions.id < question_choices.question_id [delete: cascade]
Ref: departments.id < opportunities.department_id [delete: restrict]
Ref: positions.(id, department_id) < opportunities.(position_id, department_id) [delete: restrict]
Ref: department_forms.(id, department_id) < opportunities.(form_id, department_id) [delete: restrict]
Ref: users.id < opportunities.created_by_id [delete: restrict]
Ref: users.id < applications.user_id [delete: restrict]
Ref: opportunities.id < applications.opportunity_id [delete: restrict]
Ref: users.id < applications.decided_by_id [delete: restrict]
Ref: applications.id < application_answers.application_id [delete: cascade]
Ref: form_questions.id < application_answers.question_id [delete: restrict]
Ref: files.id < application_answers.file_id [delete: restrict]
Ref: applications.id < hr_notes.application_id [delete: cascade]
Ref: users.id < hr_notes.author_id [delete: restrict]
Ref: users.id < membership_requests.user_id [delete: restrict]
Ref: departments.id < membership_requests.preferred_department_id [delete: restrict]
Ref: users.id < membership_requests.decided_by_id [delete: restrict]

// Events
Ref: users.id < events.created_by_id [delete: restrict]
Ref: files.id < events.cover_file_id [delete: set null]
Ref: events.id < event_registrations.event_id [delete: restrict]
Ref: users.id < event_registrations.created_by_id [delete: restrict]
Ref: users.id < event_registrations.decided_by_id [delete: restrict]
Ref: event_registrations.id - event_checkins.registration_id [delete: restrict]
Ref: users.id < event_checkins.checked_in_by_id [delete: restrict]
Ref: events.id < event_checkin_assignments.event_id [delete: restrict]
Ref: users.id < event_checkin_assignments.user_id [delete: restrict]
Ref: users.id < event_checkin_assignments.granted_by_id [delete: restrict]
Ref: users.id < event_checkin_assignments.revoked_by_id [delete: restrict]
Ref: event_registrations.id < registration_reminders.registration_id [delete: cascade]

// Content, media, and CMS
Ref: users.id < contents.author_id [delete: restrict]
Ref: content_categories.id < contents.category_id [delete: restrict]
Ref: files.id < contents.cover_file_id [delete: set null]
Ref: files.id - gallery_items.file_id [delete: restrict]
Ref: events.id < gallery_items.event_id [delete: set null]
Ref: users.id < gallery_items.added_by_id [delete: restrict]
Ref: users.id < page_sections.updated_by_id [delete: restrict]
Ref: files.id < page_sections.media_id [delete: set null]
Ref: contents.id < featured_items.content_id [delete: restrict]
Ref: events.id < featured_items.event_id [delete: restrict]
Ref: files.id < featured_items.file_id [delete: restrict]
Ref: users.id < featured_items.updated_by_id [delete: restrict]
Ref: users.id < site_statistics.updated_by_id [delete: restrict]
Ref: users.id < site_settings.updated_by_id [delete: restrict]
Ref: users.id < member_notifications.created_by_id [delete: restrict]
Ref: events.id < member_notifications.event_id [delete: set null]
Ref: contents.id < member_notifications.content_id [delete: set null]

// Community engagement
Ref: users.id < donations.handled_by_id [delete: restrict]
Ref: files.id < partners.logo_id [delete: set null]
Ref: users.id < partner_requests.handled_by_id [delete: restrict]
Ref: partners.id < partner_requests.partner_id [delete: set null]

// Audit
Ref: users.id < audit_logs.actor_id [delete: set null]

// =====================================================
// TABLE GROUPS
// =====================================================

TableGroup "01 - Identity and organization" {
  users
  files
  departments
  positions
  memberships
  member_profiles
}

TableGroup "02 - Recruitment" {
  department_forms
  form_questions
  question_choices
  opportunities
  applications
  application_answers
  hr_notes
  membership_requests
}

TableGroup "03 - Events" {
  events
  event_registrations
  event_checkins
  event_checkin_assignments
  registration_reminders
}

TableGroup "04 - Content and CMS" {
  content_categories
  contents
  gallery_items
  page_sections
  featured_items
  site_statistics
  site_settings
  member_notifications
}

TableGroup "05 - Community engagement" {
  donations
  partners
  partner_requests
}

TableGroup "06 - Audit" {
  audit_logs
}
