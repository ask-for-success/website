Project AFS_Backend {
  database_type: "PostgreSQL"
  Note: "Only implemented business tables are shown. Django and JWT infrastructure tables are managed by their migrations."
}

Table users {
  id uuid [pk, not null]
  email varchar(254) [not null, unique, note: "Stored in lowercase and protected by a case-insensitive unique constraint"]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  phone_number varchar(32) [unique, note: "Required for active accounts; temporarily empty only for inactive invited accounts"]
  password varchar(128) [not null, note: "Django password hash"]
  last_login timestamptz
  is_superuser boolean [not null, default: false]
  is_staff boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table departments {
  id uuid [pk, not null]
  name varchar(150) [not null]
  description text [not null, default: ""]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Name is unique case-insensitively. Deactivation preserves history."
}

Table positions {
  id uuid [pk, not null]
  department_id uuid [not null, ref: > departments.id]
  name varchar(150) [not null]
  description text [not null, default: ""]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Name is unique case-insensitively within a department."
}

Table memberships {
  id uuid [pk, not null]
  user_id uuid [not null, unique, ref: > users.id]
  status varchar(32) [not null, default: "pending_onboarding"]
  accepted_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "One durable membership exists per user."
}

Table membership_onboarding {
  id uuid [pk, not null]
  membership_id uuid [not null, unique, ref: > memberships.id]
  status varchar(16) [not null, default: "not_started"]
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Onboarding belongs to the membership and is not repeated after a department transfer."
}

Table member_identities {
  id uuid [pk, not null]
  membership_id uuid [not null, unique, ref: > memberships.id]
  national_id_number varchar(20) [not null, unique, note: "Protected complete value; never copied into audit records or ordinary member responses"]
  submitted_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "One protected identity record per membership. Values are normalized to uppercase."
}

Table member_assignments {
  id uuid [pk, not null]
  membership_id uuid [not null, ref: > memberships.id]
  department_id uuid [not null, ref: > departments.id]
  position_id uuid [not null, ref: > positions.id]
  assigned_by_id uuid [not null, ref: > users.id]
  starts_at timestamptz [not null]
  ends_at timestamptz
  end_reason text [not null, default: ""]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "A partial unique index permits only one active assignment per membership."
}

Table membership_invitations {
  id uuid [pk, not null]
  membership_id uuid [not null, ref: > memberships.id]
  user_id uuid [not null, ref: > users.id]
  created_by_id uuid [not null, ref: > users.id]
  token_hash varchar(64) [not null, unique]
  status varchar(16) [not null, default: "active"]
  expires_at timestamptz [not null]
  used_at timestamptz
  cancelled_at timestamptz
  email_delivery_status varchar(16) [not null, default: "pending"]
  email_sent_at timestamptz
  email_error text [not null, default: ""]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Only the one-time setup token hash is stored. Email failure does not invalidate the invitation."
}

Table events {
  id uuid [pk, not null]
  title varchar(200) [not null]
  summary text [not null, default: ""]
  description text [not null]
  cover_image varchar(100) [note: "Optional relative media path"]
  cover_alt_text varchar(250) [not null, default: ""]
  location varchar(255) [not null]
  attendance_label varchar(100) [not null, default: "Free"]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  registration_opens_at timestamptz
  registration_closes_at timestamptz
  capacity integer [note: "Null means unlimited capacity"]
  publication_status varchar(16) [not null, default: "draft"]
  requires_qr_code boolean [not null, default: false]
  cancelled_at timestamptz
  cancelled_by_id uuid [ref: > users.id]
  created_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table event_questions {
  id uuid [pk, not null]
  event_id uuid [not null, ref: > events.id]
  label varchar(300) [not null]
  question_type varchar(32) [not null]
  is_required boolean [not null, default: false]
  display_order integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Display order is unique within an event."
}

Table event_question_options {
  id uuid [pk, not null]
  question_id uuid [not null, ref: > event_questions.id]
  label varchar(200) [not null]
  display_order integer [not null]

  Note: "Display order is unique within a question."
}

Table event_registrations {
  id uuid [pk, not null]
  event_id uuid [not null, ref: > events.id]
  email varchar(254) [not null]
  status varchar(16) [not null, default: "registered"]
  source varchar(16) [not null, default: "public"]
  confirmation_email_status varchar(16) [not null, default: "pending"]
  confirmation_email_sent_at timestamptz
  confirmation_email_error text [not null, default: ""]
  cancelled_at timestamptz
  cancellation_source varchar(24) [not null, default: ""]
  registered_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "A case-insensitive unique constraint prevents duplicate registration for one event."
}

Table event_answers {
  id uuid [pk, not null]
  registration_id uuid [not null, ref: > event_registrations.id]
  question_id uuid [not null, ref: > event_questions.id]
  value jsonb [not null]
  created_at timestamptz [not null]
}

Table event_tickets {
  id uuid [pk, not null]
  registration_id uuid [not null, unique, ref: > event_registrations.id]
  qr_code_hash varchar(64) [not null, unique]
  delivery_status varchar(16) [not null, default: "pending"]
  sent_at timestamptz
  delivery_error text [not null, default: ""]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table event_participant_notifications {
  id uuid [pk, not null]
  event_id uuid [not null, ref: > events.id]
  registration_id uuid [not null, ref: > event_registrations.id]
  notification_type varchar(16) [not null, note: "Confirmation, rescheduled, or cancelled"]
  delivery_status varchar(16) [not null, default: "pending"]
  sent_at timestamptz
  delivery_error text [not null, default: ""]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Stores one delivery attempt per participant lifecycle notification."
}

Table event_scanners {
  id uuid [pk, not null]
  event_id uuid [not null, ref: > events.id]
  membership_id uuid [not null, ref: > memberships.id]
  assigned_by_id uuid [not null, ref: > users.id]
  is_active boolean [not null, default: true]
  assigned_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table event_check_ins {
  id uuid [pk, not null]
  ticket_id uuid [not null, unique, ref: > event_tickets.id]
  checked_in_by_id uuid [not null, ref: > users.id]
  checked_in_at timestamptz [not null]
}

Table content_page_settings {
  id uuid [pk, not null]
  section varchar(16) [not null, unique, note: "News or gallery"]
  heading varchar(200) [not null]
  introduction text [not null, default: ""]
  hero_heading varchar(200) [not null, default: ""]
  hero_introduction text [not null, default: ""]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table content_categories {
  id uuid [pk, not null]
  section varchar(16) [not null, note: "News or gallery"]
  name varchar(100) [not null]
  slug varchar(120) [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Name and slug are case-insensitively unique within a section."
}

Table news_articles {
  id uuid [pk, not null]
  category_id uuid [not null, ref: > content_categories.id]
  title varchar(220) [not null]
  slug varchar(240) [not null, unique, note: "Protected by a case-insensitive unique constraint"]
  excerpt text [not null]
  body_markdown text [not null, note: "Original Markdown; generated HTML and inline image bytes are not stored in PostgreSQL"]
  cover_image varchar(100) [not null, note: "Relative media path; image bytes are not stored in PostgreSQL"]
  cover_alt_text varchar(250) [not null]
  publication_status varchar(16) [not null, default: "draft"]
  published_at timestamptz
  is_featured boolean [not null, default: false]
  display_order integer [not null, default: 0]
  created_by_id uuid [not null, ref: > users.id]
  updated_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table member_announcements {
  id uuid [pk, not null]
  title varchar(200) [not null]
  message text [not null]
  event_id uuid [ref: > events.id]
  article_id uuid [ref: > news_articles.id]
  published_at timestamptz [not null]
  expires_at timestamptz
  is_active boolean [not null, default: true]
  created_by_id uuid [not null, ref: > users.id]
  updated_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "At most one of event_id and article_id may be set. Current active records are visible only to active members."
}

Table gallery_items {
  id uuid [pk, not null]
  category_id uuid [not null, ref: > content_categories.id]
  image varchar(100) [not null, note: "Relative media path; image bytes are not stored in PostgreSQL"]
  alt_text varchar(250) [not null]
  caption varchar(250) [not null, default: ""]
  publication_status varchar(16) [not null, default: "draft"]
  published_at timestamptz
  display_order integer [not null, default: 0]
  created_by_id uuid [not null, ref: > users.id]
  updated_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table site_settings {
  id uuid [pk, not null]
  site_key varchar(32) [not null, unique, default: "main"]
  organization_name varchar(150) [not null]
  tagline varchar(250) [not null, default: ""]
  contact_email varchar(254) [not null]
  contact_phone varchar(40) [not null]
  contact_location varchar(250) [not null]
  tiktok_url varchar(500) [not null, default: ""]
  youtube_url varchar(500) [not null, default: ""]
  instagram_url varchar(500) [not null, default: ""]
  linkedin_url varchar(500) [not null, default: ""]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table home_page_content {
  id uuid [pk, not null]
  page_key varchar(32) [not null, unique]
  hero_heading varchar(250) [not null]
  hero_highlight varchar(150) [not null, default: ""]
  hero_body text [not null]
  hero_image varchar(100)
  hero_image_alt_text varchar(250) [not null, default: ""]
  primary_cta_label varchar(100) [not null]
  primary_cta_url varchar(500) [not null]
  secondary_cta_label varchar(100) [not null]
  secondary_cta_url varchar(500) [not null]
  about_heading varchar(200) [not null]
  about_body text [not null]
  about_image varchar(100)
  about_image_alt_text varchar(250) [not null, default: ""]
  about_cta_label varchar(100) [not null]
  about_cta_url varchar(500) [not null]
  involvement_heading varchar(200) [not null]
  involvement_subheading varchar(250) [not null, default: ""]
  involvement_body text [not null, default: ""]
  events_heading varchar(200) [not null]
  events_subheading varchar(250) [not null, default: ""]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table home_features {
  id uuid [pk, not null]
  page_id uuid [not null, ref: > home_page_content.id]
  icon_key varchar(50) [not null, default: ""]
  title varchar(150) [not null]
  body text [not null]
  cta_label varchar(100) [not null]
  cta_url varchar(500) [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table impact_statistics {
  id uuid [pk, not null]
  value varchar(50) [not null]
  label varchar(150) [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table about_page_content {
  id uuid [pk, not null]
  page_key varchar(32) [not null, unique]
  hero_heading varchar(250) [not null]
  hero_highlight varchar(150) [not null, default: ""]
  hero_body text [not null]
  hero_image varchar(100)
  hero_image_alt_text varchar(250) [not null, default: ""]
  mission_heading varchar(200) [not null]
  mission_subheading varchar(250) [not null, default: ""]
  mission_body text [not null]
  pillars_heading varchar(200) [not null]
  pillars_subheading varchar(250) [not null, default: ""]
  pillars_cta_label varchar(100) [not null, default: ""]
  pillars_cta_url varchar(500) [not null, default: ""]
  story_heading varchar(200) [not null]
  story_subheading varchar(250) [not null, default: ""]
  story_body text [not null]
  story_image varchar(100)
  story_image_alt_text varchar(250) [not null, default: ""]
  closing_heading varchar(200) [not null]
  closing_body text [not null]
  primary_cta_label varchar(100) [not null]
  primary_cta_url varchar(500) [not null]
  secondary_cta_label varchar(100) [not null]
  secondary_cta_url varchar(500) [not null]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table about_pillars {
  id uuid [pk, not null]
  page_id uuid [not null, ref: > about_page_content.id]
  icon_key varchar(50) [not null, default: ""]
  title varchar(150) [not null]
  body text [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table get_involved_page_content {
  id uuid [pk, not null]
  page_key varchar(32) [not null, unique]
  hero_heading varchar(250) [not null]
  hero_highlight varchar(150) [not null, default: ""]
  hero_body text [not null]
  hero_image varchar(100)
  hero_image_alt_text varchar(250) [not null, default: ""]
  primary_cta_label varchar(100) [not null]
  primary_cta_url varchar(500) [not null]
  secondary_cta_label varchar(100) [not null]
  secondary_cta_url varchar(500) [not null]
  volunteer_heading varchar(200) [not null]
  volunteer_subheading varchar(250) [not null, default: ""]
  volunteer_body text [not null]
  volunteer_image varchar(100)
  volunteer_image_alt_text varchar(250) [not null, default: ""]
  volunteer_cta_label varchar(100) [not null]
  volunteer_cta_url varchar(500) [not null]
  partner_heading varchar(200) [not null]
  partner_subheading varchar(250) [not null, default: ""]
  partner_body text [not null]
  partner_image varchar(100)
  partner_image_alt_text varchar(250) [not null, default: ""]
  partner_cta_label varchar(100) [not null]
  partner_cta_url varchar(500) [not null]
  donation_heading varchar(200) [not null]
  donation_subheading varchar(250) [not null, default: ""]
  contact_prompt text [not null, default: ""]
  contact_cta_label varchar(100) [not null, default: ""]
  contact_cta_url varchar(500) [not null, default: ""]
  process_heading varchar(200) [not null]
  process_subheading varchar(250) [not null, default: ""]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table involvement_features {
  id uuid [pk, not null]
  page_id uuid [not null, ref: > get_involved_page_content.id]
  section varchar(16) [not null, note: "Volunteer or partner"]
  icon_key varchar(50) [not null, default: ""]
  title varchar(150) [not null]
  body text [not null, default: ""]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table donation_options {
  id uuid [pk, not null]
  page_id uuid [not null, ref: > get_involved_page_content.id]
  title varchar(150) [not null]
  instructions jsonb [not null]
  cta_label varchar(100) [not null]
  cta_url varchar(500) [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table donation_submissions {
  id uuid [pk, not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(254) [not null, note: "Normalized to lowercase"]
  phone_number varchar(40) [not null]
  donation_type varchar(16) [not null, note: "Cash or goods"]
  details text [not null]
  acknowledgement_email_status varchar(16) [not null, default: "pending"]
  acknowledgement_email_sent_at timestamptz
  acknowledgement_email_error text [not null, default: ""]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (donation_type, created_at)
    (email, created_at)
  }
}

Table involvement_steps {
  id uuid [pk, not null]
  page_id uuid [not null, ref: > get_involved_page_content.id]
  title varchar(150) [not null]
  body text [not null]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_by_id uuid [ref: > users.id]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table events_page_content {
  id uuid [pk, not null]
  page_key varchar(32) [not null, unique]
  hero_heading varchar(250) [not null]
  hero_highlight varchar(150) [not null, default: ""]
  hero_body text [not null]
  hero_image varchar(100)
  hero_image_alt_text varchar(250) [not null, default: ""]
  hero_cta_label varchar(100) [not null]
  hero_cta_url varchar(500) [not null]
  next_heading varchar(200) [not null]
  next_subheading varchar(250) [not null, default: ""]
  upcoming_heading varchar(200) [not null]
  upcoming_subheading varchar(250) [not null, default: ""]
  past_heading varchar(200) [not null]
  past_subheading varchar(250) [not null, default: ""]
  updated_by_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table gallery_videos {
  id uuid [pk, not null]
  title varchar(220) [not null]
  youtube_url varchar(500) [not null, note: "Validated YouTube URL; the video file is not stored by the application"]
  thumbnail varchar(100) [note: "Optional custom presentation thumbnail; otherwise use the derived YouTube thumbnail URL"]
  thumbnail_alt_text varchar(250) [not null, default: ""]
  duration_label varchar(50) [not null, default: ""]
  publication_status varchar(16) [not null, default: "draft"]
  published_at timestamptz
  display_order integer [not null, default: 0]
  created_by_id uuid [not null, ref: > users.id]
  updated_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table recruitment_forms {
  id uuid [pk, not null]
  department_id uuid [not null, ref: > departments.id]
  position_id uuid [not null, ref: > positions.id]
  name varchar(200) [not null]
  description text [not null, default: ""]
  status varchar(16) [not null, default: "draft"]
  created_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Name is case-insensitively unique within one department and position."
}

Table recruitment_questions {
  id uuid [pk, not null]
  form_id uuid [not null, ref: > recruitment_forms.id]
  label varchar(300) [not null]
  help_text varchar(500) [not null, default: ""]
  question_type varchar(32) [not null]
  is_required boolean [not null, default: false]
  display_order integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Display order is unique within a form."
}

Table recruitment_question_options {
  id uuid [pk, not null]
  question_id uuid [not null, ref: > recruitment_questions.id]
  label varchar(200) [not null]
  display_order integer [not null]

  Note: "Display order is unique within a question."
}

Table recruitment_opportunities {
  id uuid [pk, not null]
  form_id uuid [not null, ref: > recruitment_forms.id]
  title varchar(220) [not null]
  slug varchar(240) [not null, unique, note: "Protected by a case-insensitive unique constraint"]
  summary text [not null]
  description_markdown text [not null]
  status varchar(16) [not null, default: "draft"]
  opens_at timestamptz
  closes_at timestamptz
  created_by_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table recruitment_applications {
  id uuid [pk, not null]
  opportunity_id uuid [not null, ref: > recruitment_opportunities.id]
  applicant_id uuid [not null, ref: > users.id]
  status varchar(24) [not null, default: "submitted"]
  offer_by_id uuid [ref: > users.id]
  offered_at timestamptz
  offer_responded_at timestamptz
  offer_email_status varchar(16) [not null, default: "not_required"]
  offer_email_sent_at timestamptz
  offer_email_error text [not null, default: ""]
  decision_by_id uuid [ref: > users.id]
  decided_at timestamptz
  decision_email_status varchar(16) [not null, default: "not_required"]
  decision_email_sent_at timestamptz
  decision_email_error text [not null, default: ""]
  submitted_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Applicant is permanently unique within an opportunity regardless of status. A later campaign requires a new opportunity."
}

Table recruitment_answers {
  id uuid [pk, not null]
  application_id uuid [not null, ref: > recruitment_applications.id]
  question_id uuid [not null, ref: > recruitment_questions.id]
  value jsonb [not null]
  created_at timestamptz [not null]

  Note: "One answer is stored per application and question."
}

Table application_cvs {
  id uuid [pk, not null]
  application_id uuid [not null, unique, ref: > recruitment_applications.id]
  file varchar(500) [not null, note: "Private relative storage path; never a public media URL"]
  original_filename varchar(255) [not null]
  content_type varchar(100) [not null]
  size bigint [not null]
  sha256 varchar(64) [not null]
  uploaded_at timestamptz [not null]
}

Table audit_records {
  id uuid [pk, not null]
  domain varchar(24) [not null]
  action varchar(64) [not null]
  actor_id uuid [not null, ref: > users.id]
  application_id uuid [ref: > recruitment_applications.id]
  membership_id uuid [ref: > memberships.id]
  target_type varchar(150) [not null, default: ""]
  target_id uuid
  operation varchar(180) [not null, default: ""]
  request_method varchar(8) [not null, default: ""]
  request_path varchar(500) [not null, default: "", note: "Path only; query parameters and request bodies are not stored"]
  previous_state jsonb [not null, default: `{}`]
  new_state jsonb [not null, default: `{}`]
  reason text [not null, default: ""]
  created_at timestamptz [not null]

  Note: "Immutable actor-centered history. At least one generic or relational business target is required. State keys are allowlisted and secrets are prohibited."
}
