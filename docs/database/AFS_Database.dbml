Project AFS_Base_Donnees {
  database_type: 'PostgreSQL'
  Note: 'Ask For Success - Site public, recrutement, espace membre et gestion interne'
}

// =====================================================
// DECISIONS TECHNIQUES
// =====================================================

// PostgreSQL est le moteur retenu.
// Les identifiants publics et internes utilisent UUID.
// L'extension PostgreSQL citext garantit l'unicite des courriels sans tenir compte de la casse.
// Les secrets, les fichiers et les documents sensibles ne sont jamais stockes directement en base.
// La base conserve uniquement les metadonnees et les cles du stockage d'objets.
//
// Django genere et gere ses propres tables techniques, notamment :
// - django_migrations
// - django_content_type
// - django_session
// - auth_group
// - auth_permission
// - les tables de liaison entre utilisateurs, groupes et permissions
//
// Ces tables techniques ne sont pas reproduites dans ce modele metier.

// =====================================================
// ENUMERATIONS
// =====================================================

Enum statut_compte {
  actif
  desactive
}

Enum statut_adhesion {
  integration_requise
  active
  suspendue
}

Enum statut_fichier {
  provisoire
  en_analyse
  disponible
  rejete
  archive
}

Enum type_fichier {
  image
  video
  document
  lien_externe
}

Enum confidentialite_fichier {
  public
  interne
  sensible
}

Enum type_question {
  texte_court
  texte_long
  choix
  date
  fichier
}

Enum statut_opportunite {
  brouillon
  publiee
  archivee
}

Enum statut_candidature {
  soumise
  en_etude
  contactee
  entretien
  approuvee
  rejetee
}

Enum statut_demande_adhesion {
  soumise
  en_etude
  approuvee
  rejetee
}

Enum statut_envoi {
  non_requis
  en_attente
  envoye
  echec
}

Enum statut_evenement {
  publie
  archive
}

Enum mode_validation_inscription {
  automatique
  manuelle
}

Enum source_inscription {
  publique
  manuelle
}

Enum statut_inscription {
  en_attente
  approuvee
  rejetee
}

Enum statut_qr {
  non_requis
  en_attente
  envoye
  echec
}

Enum methode_controle {
  qr
  manuel
}

Enum statut_rappel {
  programme
  envoye
  echec
}

Enum type_contenu {
  actualite
  histoire
  annonce
}

Enum statut_publication {
  publie
  archive
}

Enum type_notification {
  annonce
  evenement
  contenu
  systeme
}

Enum type_don {
  argent
  biens
}

Enum mode_remise_don {
  depot
  collecte
}

Enum statut_don {
  nouveau
  contacte
  confirme
  recu
  refuse
}

Enum type_organisation {
  ecole
  entreprise
  association
  autre
}

Enum type_offre_partenaire {
  lieu
  stage
  atelier
  parrainage
  autre
}

Enum statut_demande_partenaire {
  nouvelle
  en_discussion
  acceptee
  refusee
}

// =====================================================
// MODULE 01 - IDENTITE, ORGANISATION ET ACCES
// =====================================================

Table UTILISATEURS {
  id uuid [pk, default: `gen_random_uuid()`]
  prenom varchar(100) [not null]
  nom varchar(100) [not null]
  courriel citext [unique, not null]
  telephone varchar(30)
  empreinte_mot_de_passe varchar(255) [not null]
  statut statut_compte [not null, default: 'actif']
  courriel_verifie_le timestamptz
  derniere_connexion_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table FICHIERS {
  id uuid [pk, default: `gen_random_uuid()`]
  proprietaire_id uuid
  nom_original varchar(255) [not null]
  cle_stockage varchar(500) [unique]
  url_externe varchar(1000)
  type type_fichier [not null]
  type_mime varchar(150)
  taille_octets bigint
  empreinte_sha256 char(64)
  confidentialite confidentialite_fichier [not null, default: 'interne']
  statut statut_fichier [not null, default: 'provisoire']
  cree_le timestamptz [not null, default: `now()`]
  analyse_le timestamptz
  archive_le timestamptz

  Note: 'Un lien externe utilise url_externe. Un fichier televerse utilise cle_stockage. Les documents identitaires utilisent la confidentialite sensible.'
}

Table DEPARTEMENTS {
  id uuid [pk, default: `gen_random_uuid()`]
  nom varchar(150) [unique, not null]
  identifiant_url varchar(150) [unique, not null]
  description text
  actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table FONCTIONS {
  id uuid [pk, default: `gen_random_uuid()`]
  departement_id uuid [not null]
  nom varchar(150) [not null]
  description text
  actif boolean [not null, default: true]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  indexes {
    (departement_id, nom) [unique]
    (id, departement_id) [unique]
  }
}

Table ADHESIONS_MEMBRES {
  utilisateur_id uuid [pk]
  departement_principal_id uuid [not null]
  fonction_principale_id uuid [not null]
  approuvee_par_id uuid [not null]
  statut statut_adhesion [not null, default: 'integration_requise']
  approuvee_le timestamptz [not null, default: `now()`]
  integration_terminee_le timestamptz
  activee_le timestamptz
  suspendue_le timestamptz
  modifiee_le timestamptz [not null, default: `now()`]
}

Table PROFILS_MEMBRES {
  utilisateur_id uuid [pk]
  date_naissance date [not null]
  ecole_ou_universite varchar(200) [not null]
  ville varchar(100)
  titre_public varchar(150)
  photo_id uuid
  document_identite_id uuid [not null, unique]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  Note: 'Le document identitaire est un fichier sensible protege. Aucune adresse publique ne doit le rendre accessible.'
}

// =====================================================
// MODULE 02 - RECRUTEMENT ET ADHESION DIRECTE
// =====================================================

Table FORMULAIRES_DEPARTEMENT {
  id uuid [pk, default: `gen_random_uuid()`]
  departement_id uuid [unique, not null]
  cree_par_id uuid [not null]
  titre varchar(200) [not null]
  verrouille_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  Note: 'Un formulaire est verrouille automatiquement des la premiere candidature soumise pour son departement.'

  indexes {
    (id, departement_id) [unique]
  }
}

Table QUESTIONS_FORMULAIRE {
  id uuid [pk, default: `gen_random_uuid()`]
  formulaire_id uuid [not null]
  libelle text [not null]
  type type_question [not null]
  obligatoire boolean [not null, default: true]
  ordre int [not null, default: 0]
  regles_fichier jsonb
  cree_le timestamptz [not null, default: `now()`]
}

Table CHOIX_QUESTION {
  id uuid [pk, default: `gen_random_uuid()`]
  question_id uuid [not null]
  valeur varchar(150) [not null]
  libelle varchar(200) [not null]
  ordre int [not null, default: 0]

  indexes {
    (question_id, valeur) [unique]
  }
}

Table OPPORTUNITES {
  id uuid [pk, default: `gen_random_uuid()`]
  departement_id uuid [not null]
  fonction_id uuid
  formulaire_id uuid [not null]
  cree_par_id uuid [not null]
  titre varchar(200) [not null]
  identifiant_url varchar(200) [unique, not null]
  description text
  statut statut_opportunite [not null, default: 'brouillon']
  ouverture_le timestamptz
  fermeture_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table CANDIDATURES {
  id uuid [pk, default: `gen_random_uuid()`]
  utilisateur_id uuid [not null]
  opportunite_id uuid [not null]
  statut statut_candidature [not null, default: 'soumise']
  soumise_le timestamptz [not null, default: `now()`]
  mise_en_etude_le timestamptz
  decidee_par_id uuid
  decidee_le timestamptz
  statut_courriel_decision statut_envoi [not null, default: 'non_requis']
  courriel_decision_envoye_le timestamptz
  erreur_courriel_decision text
  modifiee_le timestamptz [not null, default: `now()`]

  indexes {
    (utilisateur_id, opportunite_id) [unique]
    (statut, soumise_le)
  }
}

Table REPONSES_CANDIDATURE {
  id uuid [pk, default: `gen_random_uuid()`]
  candidature_id uuid [not null]
  question_id uuid [not null]
  valeur_texte text
  valeur_date date
  fichier_id uuid

  indexes {
    (candidature_id, question_id) [unique]
  }

  Note: 'Une reponse utilise la colonne correspondant au type de sa question. Les reponses deviennent immuables apres la soumission.'
}

Table NOTES_RH {
  id uuid [pk, default: `gen_random_uuid()`]
  candidature_id uuid [not null]
  auteur_id uuid [not null]
  contenu text [not null]
  cree_le timestamptz [not null, default: `now()`]

  Note: 'Les notes RH ne sont jamais exposees au candidat ni aux membres ordinaires.'
}

Table DEMANDES_ADHESION {
  id uuid [pk, default: `gen_random_uuid()`]
  utilisateur_id uuid [not null]
  departement_souhaite_id uuid [not null]
  motivation text [not null]
  statut statut_demande_adhesion [not null, default: 'soumise']
  soumise_le timestamptz [not null, default: `now()`]
  decidee_par_id uuid
  decidee_le timestamptz
  statut_courriel_decision statut_envoi [not null, default: 'non_requis']
  courriel_decision_envoye_le timestamptz
  erreur_courriel_decision text
  modifiee_le timestamptz [not null, default: `now()`]

  indexes {
    (utilisateur_id, soumise_le)
    (statut, soumise_le)
  }
}

// =====================================================
// MODULE 03 - EVENEMENTS, INSCRIPTIONS ET CONTROLE
// =====================================================

Table EVENEMENTS {
  id uuid [pk, default: `gen_random_uuid()`]
  cree_par_id uuid [not null]
  titre varchar(200) [not null]
  identifiant_url varchar(200) [unique, not null]
  resume text
  description text
  debut_le timestamptz [not null]
  fin_le timestamptz [not null]
  lieu varchar(200)
  ville varchar(100)
  capacite int
  prix numeric(12,2) [not null, default: 0]
  devise char(3) [not null, default: 'MAD']
  couverture_id uuid
  inscription_active boolean [not null, default: false]
  inscription_ouvre_le timestamptz
  inscription_ferme_le timestamptz
  mode_validation mode_validation_inscription [not null, default: 'automatique']
  qr_actif boolean [not null, default: false]
  qr_envoi_le timestamptz
  statut statut_evenement [not null, default: 'publie']
  publie_le timestamptz [not null, default: `now()`]
  archive_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  Note: 'Le debut doit preceder la fin. La capacite et le prix sont positifs. Le QR exige une inscription active.'
}

Table INSCRIPTIONS_EVENEMENT {
  id uuid [pk, default: `gen_random_uuid()`]
  evenement_id uuid [not null]
  creee_par_id uuid
  source source_inscription [not null, default: 'publique']
  nom_complet varchar(150) [not null]
  courriel citext [not null]
  ecole_ou_universite varchar(200) [not null]
  date_naissance date [not null]
  ville varchar(100) [not null]
  statut statut_inscription [not null, default: 'en_attente']
  decidee_par_id uuid
  decidee_le timestamptz
  empreinte_jeton_qr char(64) [unique]
  statut_qr statut_qr [not null, default: 'non_requis']
  qr_envoye_le timestamptz
  erreur_qr text
  inscrite_le timestamptz [not null, default: `now()`]
  modifiee_le timestamptz [not null, default: `now()`]

  indexes {
    (evenement_id, courriel) [unique]
    (evenement_id, statut, inscrite_le)
  }
}

Table CONTROLES_ENTREE {
  id uuid [pk, default: `gen_random_uuid()`]
  inscription_id uuid [unique, not null]
  controle_par_id uuid [not null]
  methode methode_controle [not null]
  controle_le timestamptz [not null, default: `now()`]

  Note: 'Une seule ligne de controle valide est autorisee par inscription. Les lectures suivantes ne creent aucune ligne supplementaire.'
}

Table AFFECTATIONS_CONTROLE_EVENEMENT {
  id uuid [pk, default: `gen_random_uuid()`]
  evenement_id uuid [not null]
  utilisateur_id uuid [not null]
  attribuee_par_id uuid [not null]
  attribuee_le timestamptz [not null, default: `now()`]
  revoquee_par_id uuid
  revoquee_le timestamptz

  indexes {
    (evenement_id, utilisateur_id, attribuee_le)
  }

  Note: 'PostgreSQL impose un index unique partiel sur evenement_id et utilisateur_id lorsque revoquee_le est NULL.'
}

Table RAPPELS_INSCRIPTION {
  id uuid [pk, default: `gen_random_uuid()`]
  inscription_id uuid [not null]
  cle_rappel varchar(50) [not null]
  programme_le timestamptz [not null]
  statut statut_rappel [not null, default: 'programme']
  envoye_le timestamptz
  erreur text

  indexes {
    (inscription_id, cle_rappel) [unique]
  }
}

// =====================================================
// MODULE 04 - CONTENUS, MEDIAS ET CMS
// =====================================================

Table CATEGORIES_CONTENU {
  id uuid [pk, default: `gen_random_uuid()`]
  nom varchar(100) [not null]
  identifiant_url varchar(100) [unique, not null]
  ordre int [not null, default: 0]
}

Table CONTENUS {
  id uuid [pk, default: `gen_random_uuid()`]
  auteur_id uuid [not null]
  categorie_id uuid [not null]
  couverture_id uuid
  type type_contenu [not null]
  titre varchar(250) [not null]
  identifiant_url varchar(250) [unique, not null]
  resume text
  corps text [not null]
  lien_externe varchar(1000)
  statut statut_publication [not null, default: 'publie']
  publie_le timestamptz [not null, default: `now()`]
  archive_le timestamptz
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  indexes {
    (statut, publie_le)
    (categorie_id, statut, publie_le)
  }
}

Table ELEMENTS_GALERIE {
  id uuid [pk, default: `gen_random_uuid()`]
  fichier_id uuid [unique, not null]
  evenement_id uuid
  ajoute_par_id uuid [not null]
  legende text
  visible boolean [not null, default: true]
  ordre int [not null, default: 0]
  ajoute_le timestamptz [not null, default: `now()`]
}

Table SECTIONS_PAGE {
  id uuid [pk, default: `gen_random_uuid()`]
  modifiee_par_id uuid [not null]
  page varchar(50) [not null]
  cle_section varchar(100) [not null]
  titre varchar(250)
  corps text
  media_id uuid
  ordre int [not null, default: 0]
  modifiee_le timestamptz [not null, default: `now()`]

  indexes {
    (page, cle_section) [unique]
  }

  Note: 'Les pages utilisent des sections fixes. En V1, Enregistrer et publier remplace immediatement la valeur publiee.'
}

Table MISES_EN_AVANT {
  id uuid [pk, default: `gen_random_uuid()`]
  cle_emplacement varchar(100) [not null]
  contenu_id uuid
  evenement_id uuid
  fichier_id uuid
  ordre int [not null, default: 0]
  modifiee_par_id uuid [not null]
  modifiee_le timestamptz [not null, default: `now()`]

  indexes {
    (cle_emplacement, ordre) [unique]
  }

  Note: 'Une mise en avant reference exactement un contenu, un evenement ou un fichier.'
}

Table STATISTIQUES_SITE {
  id uuid [pk, default: `gen_random_uuid()`]
  libelle varchar(100) [not null]
  valeur varchar(50) [not null]
  visible boolean [not null, default: true]
  ordre int [not null, default: 0]
  modifiee_par_id uuid [not null]
  modifiee_le timestamptz [not null, default: `now()`]
}

Table PARAMETRES_SITE {
  id uuid [pk, default: `gen_random_uuid()`]
  cle varchar(100) [unique, not null]
  valeur jsonb [not null]
  description text
  public boolean [not null, default: false]
  modifie_par_id uuid [not null]
  modifie_le timestamptz [not null, default: `now()`]

  Note: 'Les secrets et les informations sensibles ne sont jamais conserves dans cette table.'
}

Table NOTIFICATIONS_MEMBRES {
  id uuid [pk, default: `gen_random_uuid()`]
  creee_par_id uuid [not null]
  evenement_id uuid
  contenu_id uuid
  titre varchar(200) [not null]
  message text [not null]
  type type_notification [not null, default: 'systeme']
  lien varchar(1000)
  envoyee_le timestamptz [not null, default: `now()`]

  Note: 'V1 diffuse les notifications a tous les membres. Aucun etat de lecture nest gere.'
}

// =====================================================
// MODULE 05 - ENGAGEMENT
// =====================================================

Table DONS {
  id uuid [pk, default: `gen_random_uuid()`]
  traite_par_id uuid
  type type_don [not null]
  nom_donateur varchar(150) [not null]
  courriel citext
  telephone varchar(30)
  montant numeric(12,2)
  devise char(3) [default: 'MAD']
  description_biens text
  mode_remise mode_remise_don
  statut statut_don [not null, default: 'nouveau']
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]

  Note: 'Un don en argent exige un montant positif. Un don en biens exige une description et un mode de remise.'
}

Table PARTENAIRES {
  id uuid [pk, default: `gen_random_uuid()`]
  nom varchar(200) [not null]
  logo_id uuid
  type type_organisation
  visible boolean [not null, default: true]
  ordre int [not null, default: 0]
  cree_le timestamptz [not null, default: `now()`]
  modifie_le timestamptz [not null, default: `now()`]
}

Table DEMANDES_PARTENARIAT {
  id uuid [pk, default: `gen_random_uuid()`]
  traitee_par_id uuid
  partenaire_id uuid
  nom_organisation varchar(200) [not null]
  type_organisation type_organisation [not null]
  nom_contact varchar(150) [not null]
  courriel citext [not null]
  telephone varchar(30)
  type_offre type_offre_partenaire [not null]
  message text [not null]
  statut statut_demande_partenaire [not null, default: 'nouvelle']
  creee_le timestamptz [not null, default: `now()`]
  modifiee_le timestamptz [not null, default: `now()`]
}

// =====================================================
// MODULE 06 - AUDIT
// =====================================================

Table JOURNAL_AUDIT {
  id uuid [pk, default: `gen_random_uuid()`]
  acteur_id uuid
  code_action varchar(100) [not null]
  type_cible varchar(100) [not null]
  identifiant_cible varchar(100)
  reussite boolean [not null, default: true]
  details jsonb
  identifiant_requete uuid
  adresse_reseau inet
  signature_client text
  cree_le timestamptz [not null, default: `now()`]

  indexes {
    (code_action, cree_le)
    (type_cible, identifiant_cible, cree_le)
    (acteur_id, cree_le)
  }

  Note: 'Journal en ajout seulement. Les mots de passe, jetons et documents sensibles sont exclus des details.'
}

// =====================================================
// RELATIONS ET POLITIQUES DE SUPPRESSION
// =====================================================

// Identite et organisation
Ref: UTILISATEURS.id < FICHIERS.proprietaire_id [delete: set null]
Ref: DEPARTEMENTS.id < FONCTIONS.departement_id [delete: restrict]
Ref: UTILISATEURS.id - ADHESIONS_MEMBRES.utilisateur_id [delete: restrict]
Ref: DEPARTEMENTS.id < ADHESIONS_MEMBRES.departement_principal_id [delete: restrict]
Ref: FONCTIONS.(id, departement_id) < ADHESIONS_MEMBRES.(fonction_principale_id, departement_principal_id) [delete: restrict]
Ref: UTILISATEURS.id < ADHESIONS_MEMBRES.approuvee_par_id [delete: restrict]
Ref: UTILISATEURS.id - PROFILS_MEMBRES.utilisateur_id [delete: cascade]
Ref: FICHIERS.id < PROFILS_MEMBRES.photo_id [delete: set null]
Ref: FICHIERS.id < PROFILS_MEMBRES.document_identite_id [delete: restrict]

// Recrutement
Ref: DEPARTEMENTS.id - FORMULAIRES_DEPARTEMENT.departement_id [delete: restrict]
Ref: UTILISATEURS.id < FORMULAIRES_DEPARTEMENT.cree_par_id [delete: restrict]
Ref: FORMULAIRES_DEPARTEMENT.id < QUESTIONS_FORMULAIRE.formulaire_id [delete: restrict]
Ref: QUESTIONS_FORMULAIRE.id < CHOIX_QUESTION.question_id [delete: cascade]
Ref: DEPARTEMENTS.id < OPPORTUNITES.departement_id [delete: restrict]
Ref: FONCTIONS.(id, departement_id) < OPPORTUNITES.(fonction_id, departement_id) [delete: restrict]
Ref: FORMULAIRES_DEPARTEMENT.(id, departement_id) < OPPORTUNITES.(formulaire_id, departement_id) [delete: restrict]
Ref: UTILISATEURS.id < OPPORTUNITES.cree_par_id [delete: restrict]
Ref: UTILISATEURS.id < CANDIDATURES.utilisateur_id [delete: restrict]
Ref: OPPORTUNITES.id < CANDIDATURES.opportunite_id [delete: restrict]
Ref: UTILISATEURS.id < CANDIDATURES.decidee_par_id [delete: restrict]
Ref: CANDIDATURES.id < REPONSES_CANDIDATURE.candidature_id [delete: cascade]
Ref: QUESTIONS_FORMULAIRE.id < REPONSES_CANDIDATURE.question_id [delete: restrict]
Ref: FICHIERS.id < REPONSES_CANDIDATURE.fichier_id [delete: restrict]
Ref: CANDIDATURES.id < NOTES_RH.candidature_id [delete: cascade]
Ref: UTILISATEURS.id < NOTES_RH.auteur_id [delete: restrict]
Ref: UTILISATEURS.id < DEMANDES_ADHESION.utilisateur_id [delete: restrict]
Ref: DEPARTEMENTS.id < DEMANDES_ADHESION.departement_souhaite_id [delete: restrict]
Ref: UTILISATEURS.id < DEMANDES_ADHESION.decidee_par_id [delete: restrict]

// Evenements
Ref: UTILISATEURS.id < EVENEMENTS.cree_par_id [delete: restrict]
Ref: FICHIERS.id < EVENEMENTS.couverture_id [delete: set null]
Ref: EVENEMENTS.id < INSCRIPTIONS_EVENEMENT.evenement_id [delete: restrict]
Ref: UTILISATEURS.id < INSCRIPTIONS_EVENEMENT.creee_par_id [delete: restrict]
Ref: UTILISATEURS.id < INSCRIPTIONS_EVENEMENT.decidee_par_id [delete: restrict]
