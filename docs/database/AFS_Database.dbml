Project AFS_Database {
  database_type: 'MySQL'
  Note: 'Ask For Success - Website and Member Platform'
}

// =====================================================
//  ENUMS
// =====================================================

Enum user_status {
  applicant
  member
  suspended
}

Enum notification_type {
  announcement
  event
  opportunity
  system
}

Enum log_action {
  created
  updated
  deleted
  approved
  rejected
}

Enum log_entity_type {
  user
  role
  permission
  position
  application
  event
  event_registration 
  article
  article_category 
  gallery_photo
  gallery_video
  gallery_category 
  donation
  partner
  partner_request
  page_section 
  site_setting 
  stat 
}

Enum question_type {
  short_text
  long_text
  choice          
  multiple_choice 
  yes_no
  file_upload     
}

Enum application_status {
  pending
  approved
  rejected
}

Enum event_type {
  summit
  workshop
  outreach
  }

Enum event_status {
  draft
  published
  cancelled
}

Enum registration_status {
  pending
  issued
}

Enum publish_status {
  draft
  published
}

Enum donation_type {
  cash
  goods
}

Enum delivery_method {
  drop_off
  pickup
}

Enum donation_status {
  new
  contacted
  confirmed
  received
  declined
}

Enum org_type {
  school
  company
  ngo
}

Enum offer_type {
  venue
  internship
  workshop
  sponsorship
}

Enum partner_request_status {
  new
  in_discussion
  accepted
  declined
}

Enum language_code {
  ar
  fr
  en
}

// =====================================================
// MODULE 01: IDENTITY & ACCESS MANAGEMENT
// =====================================================

Table USERS {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  status user_status [not null, default: 'applicant'] 
  email_verified_at datetime
  created_at datetime [not null, default: `now()`] 
}

Table MEMBER_PROFILES {
  user_id int [pk] 
  phone varchar(30)
  birth_date date
  cin varchar(30) // sensitive data: protect it
  city varchar(100)
  public_title varchar(150)
  created_at datetime [not null, default: `now()`]
}

Table ROLES {
  id int [pk, increment]
  name varchar(100) [unique, not null] 
  description text
  is_system boolean [not null, default: false]
}

Table PERMISSIONS {
  id int [pk, increment]
  code varchar(100) [unique, not null]
  module varchar(50) [not null]
  description text
}

Table USER_ROLES {
  user_id int [not null]
  role_id int [not null]
  assigned_at datetime [not null, default: `now()`]
  assigned_by int

  indexes {
    (user_id, role_id) [pk]
  }
}

Table ROLE_PERMISSIONS {
  role_id int [not null]
  permission_id int [not null]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table NOTIFICATIONS {
  id int [pk, increment]
  role_id int [not null]
  title varchar(200) [not null]
  message text
  type notification_type [not null, default: 'system']
  link_url varchar(500)
  is_read boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
}

Table ACTIVITY_LOGS {
  id int [pk, increment]
  user_id int [not null]
  action log_action [not null]
  entity_type log_entity_type [not null]
  entity_id int
  created_at datetime [not null, default: `now()`]
}

// =====================================================
// MODULE 02: RECRUITMENT & APPLICATIONS
// =====================================================

Table POSITIONS {
  id int [pk, increment]
  created_by int [not null]
  title varchar(200) [not null]
  slug varchar(200) [not null, unique]
  description text
  created_at datetime [not null, default: `now()`]
  updated_at datetime
}

Table POSITION_QUESTIONS {
  id int [pk, increment]
  position_id int [not null]
  question_text text [not null]
  question_type question_type [not null]
  options text
  is_required boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table APPLICATIONS {
  id int [pk, increment]
  user_id int [not null]
  position_id int [not null]
  status application_status [not null, default: 'pending'] 
  submitted_at datetime [not null, default: `now()`] 
  reviewed_by int
  reviewed_at datetime

  indexes {
    (user_id, position_id) [unique] 
  }
}

Table APPLICATION_ANSWERS {
  id int [pk, increment]
  application_id int [not null]
  question_id int [not null]
  answer_text text
  answer_file_url varchar(500)

  indexes {
    (application_id, question_id) [unique] 
  }
}

// =====================================================
// MODULE 03: EVENTS & REGISTRATIONS
// =====================================================

Table EVENTS {
  id int [pk, increment]
  created_by int [not null]
  title varchar(200) [not null]
  slug varchar(200) [not null, unique]
  event_type event_type [not null]
  description text
  start_date date [not null]
  end_date date
  start_time time
  end_time time
  venue varchar(200)
  city varchar(100)
  total_seats int
  price decimal(10,2) [not null, default: 0]
  cover_image_url varchar(500)
  is_featured boolean [not null, default: false]
  status event_status [not null, default: 'draft']
  created_at datetime [not null, default: `now()`]
  updated_at datetime
}

Table EVENT_REGISTRATIONS {
  id int [pk, increment]
  event_id int [not null]
  full_name varchar(150) [not null]
  email varchar(255) [not null]
  phone varchar(30)
  age int
  city varchar(100)
  occupation varchar(100) 
  field_of_study varchar(150)
  education_level varchar(100)
  school_or_organization varchar(200)
  referral_source varchar(100)
  unique_token varchar(100) [not null, unique]
  status registration_status [not null, default: 'pending']
  registered_at datetime [not null, default: `now()`]
  ticket_sent_at datetime
  checked_in_at datetime

  indexes {
    (event_id, email) [unique]
  }
}

Table EVENT_REGISTRATION_REMINDERS {
  id int [pk, increment]
  registration_id int [not null]
  reminder_key varchar(50) [not null]
  sent_at datetime [not null, default: `now()`]

  indexes {
    (registration_id, reminder_key) [unique]
  }
}

// =====================================================
// MODULE 04: CONTENT & MEDIA MANAGEMENT
// =====================================================

Table ARTICLE_CATEGORIES {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [not null, unique]
}

Table ARTICLES {
  id int [pk, increment]
  author_id int [not null]
  category_id int [not null]
  title varchar(250) [not null]
  slug varchar(250) [not null, unique]
  excerpt text
  content text
  cover_image_url varchar(500)
  read_time_minutes int
  is_featured boolean [not null, default: false]
  status publish_status [not null, default: 'draft']
  published_at datetime
}

Table GALLERY_CATEGORIES {
  id int [pk, increment]
  name varchar(100) [not null]
  sort_order int [not null, default: 0]
}

Table GALLERY_PHOTOS {
  id int [pk, increment]
  category_id int [not null]
  event_id int
  uploaded_by int [not null]
  image_url varchar(500) [not null]
  caption text
  is_visible boolean [not null, default: true]
  sort_order int [not null, default: 0]
  uploaded_at datetime [not null, default: `now()`]
}

Table GALLERY_VIDEOS {
  id int [pk, increment]
  event_id int
  uploaded_by int [not null]
  title varchar(200) [not null]
  video_url varchar(500) [not null]
  thumbnail_url varchar(500)
  duration_seconds int
  published_date date
  is_visible boolean [not null, default: true]
}

// =====================================================
// MODULE 05: COMMUNITY & ENGAGEMENT
// =====================================================

Table DONATIONS {
  id int [pk, increment]
  handled_by int
  donation_type donation_type [not null]
  donor_name varchar(150) [not null]
  email varchar(255)
  phone varchar(30)
  amount decimal(10,2)
  goods_description text
  delivery_method delivery_method
  status donation_status [not null, default: 'new']
  created_at datetime [not null, default: `now()`]
}

Table PARTNERS {
  id int [pk, increment]
  name varchar(200) [not null]
  logo_url varchar(500)
  partner_type org_type
  is_visible boolean [not null, default: true]
  sort_order int [not null, default: 0]
}

Table PARTNER_REQUESTS {
  id int [pk, increment]
  handled_by int
  partner_id int
  organization_name varchar(200) [not null]
  organization_type org_type [not null]
  contact_name varchar(150) [not null]
  email varchar(255) [not null]
  phone varchar(30)
  offer_type offer_type
  message text
  status partner_request_status [not null, default: 'new']
  created_at datetime [not null, default: `now()`]
}

// =====================================================
// MODULE 06: WEBSITE CMS & CONFIGURATION
// =====================================================

Table STATS {
  id int [pk, increment]
  label varchar(100) [not null]
  value varchar(50) [not null]
  sort_order int [not null, default: 0]
}

Table PAGE_SECTIONS {
  id int [pk, increment]
  updated_by int [not null]
  page varchar(50) [not null]
  section_key varchar(100) [not null]
  title varchar(250)
  body text
  image_url varchar(500)
  sort_order int [not null, default: 0]
  updated_at datetime

  indexes {
    (page, section_key) [unique] 
  }
}

Table SITE_SETTINGS {
  id int [pk, increment]
  setting_key varchar(100) [unique, not null]
  setting_value text
}

Table TRANSLATIONS {
  id int [pk, increment]
  entity_type varchar(50) [not null]
  entity_id int [not null]
  language language_code [not null]
  field_name varchar(50) [not null]
  value text

  indexes {
    (entity_type, entity_id, language, field_name) [unique] 
  }
}

// =====================================================
// RELATIONSHIPS
// =====================================================

// 01. Identity & Access

Ref: USERS.id < USER_ROLES.user_id
Ref: ROLES.id < USER_ROLES.role_id
Ref: USERS.id < USER_ROLES.assigned_by

Ref: USERS.id - MEMBER_PROFILES.user_id

Ref: ROLES.id < ROLE_PERMISSIONS.role_id
Ref: PERMISSIONS.id < ROLE_PERMISSIONS.permission_id

Ref: ROLES.id < NOTIFICATIONS.role_id
Ref: USERS.id < ACTIVITY_LOGS.user_id

// 02. Recruitment

Ref: USERS.id < POSITIONS.created_by

Ref: USERS.id < APPLICATIONS.user_id
Ref: USERS.id < APPLICATIONS.reviewed_by

Ref: POSITIONS.id < APPLICATIONS.position_id
Ref: POSITIONS.id < POSITION_QUESTIONS.position_id

Ref: APPLICATIONS.id < APPLICATION_ANSWERS.application_id
Ref: POSITION_QUESTIONS.id < APPLICATION_ANSWERS.question_id

// 03. Events

Ref: USERS.id < EVENTS.created_by
Ref: EVENTS.id < EVENT_REGISTRATIONS.event_id
Ref: EVENT_REGISTRATIONS.id < EVENT_REGISTRATION_REMINDERS.registration_id

// 04. Content & Media

Ref: USERS.id < ARTICLES.author_id
Ref: ARTICLE_CATEGORIES.id < ARTICLES.category_id

Ref: EVENTS.id < GALLERY_PHOTOS.event_id
Ref: EVENTS.id < GALLERY_VIDEOS.event_id

Ref: GALLERY_CATEGORIES.id < GALLERY_PHOTOS.category_id

Ref: USERS.id < GALLERY_PHOTOS.uploaded_by
Ref: USERS.id < GALLERY_VIDEOS.uploaded_by

// 05. Community & Engagement

Ref: USERS.id < DONATIONS.handled_by

Ref: USERS.id < PARTNER_REQUESTS.handled_by
Ref: PARTNERS.id < PARTNER_REQUESTS.partner_id

// 06. Website CMS

Ref: USERS.id < PAGE_SECTIONS.updated_by

// =====================================================
// TABLE GROUPS
// =====================================================

TableGroup "01 - Identity & Access" {
  USERS
  MEMBER_PROFILES 
  ROLES
  PERMISSIONS
  USER_ROLES
  ROLE_PERMISSIONS
  NOTIFICATIONS
  ACTIVITY_LOGS
}

TableGroup "02 - Recruitment" {
  POSITIONS
  POSITION_QUESTIONS
  APPLICATIONS
  APPLICATION_ANSWERS
}

TableGroup "03 - Events" {
  EVENTS
  EVENT_REGISTRATIONS
  EVENT_REGISTRATION_REMINDERS 
}

TableGroup "04 - Content & Media" {
  ARTICLE_CATEGORIES
  ARTICLES
  GALLERY_CATEGORIES
  GALLERY_PHOTOS
  GALLERY_VIDEOS
}

TableGroup "05 - Community & Engagement" {
  DONATIONS
  PARTNERS
  PARTNER_REQUESTS
}

TableGroup "06 - Website CMS" {
  STATS
  PAGE_SECTIONS
  SITE_SETTINGS
  TRANSLATIONS
}
