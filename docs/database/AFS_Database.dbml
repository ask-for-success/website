Ref: EVENEMENTS.id < AFFECTATIONS_CONTROLE_EVENEMENT.evenement_id [delete: restrict]
Ref: UTILISATEURS.id < AFFECTATIONS_CONTROLE_EVENEMENT.utilisateur_id [delete: restrict]
Ref: UTILISATEURS.id < AFFECTATIONS_CONTROLE_EVENEMENT.attribuee_par_id [delete: restrict]
Ref: UTILISATEURS.id < AFFECTATIONS_CONTROLE_EVENEMENT.revoquee_par_id [delete: restrict]
Ref: INSCRIPTIONS_EVENEMENT.id < RAPPELS_INSCRIPTION.inscription_id [delete: cascade]

// Contenus, medias et CMS
Ref: UTILISATEURS.id < CONTENUS.auteur_id [delete: restrict]
Ref: CATEGORIES_CONTENU.id < CONTENUS.categorie_id [delete: restrict]
Ref: FICHIERS.id < CONTENUS.couverture_id [delete: set null]
Ref: FICHIERS.id - ELEMENTS_GALERIE.fichier_id [delete: restrict]
Ref: EVENEMENTS.id < ELEMENTS_GALERIE.evenement_id [delete: set null]
Ref: UTILISATEURS.id < ELEMENTS_GALERIE.ajoute_par_id [delete: restrict]
Ref: UTILISATEURS.id < SECTIONS_PAGE.modifiee_par_id [delete: restrict]
Ref: FICHIERS.id < SECTIONS_PAGE.media_id [delete: set null]
Ref: CONTENUS.id < MISES_EN_AVANT.contenu_id [delete: restrict]
Ref: EVENEMENTS.id < MISES_EN_AVANT.evenement_id [delete: restrict]
Ref: FICHIERS.id < MISES_EN_AVANT.fichier_id [delete: restrict]
Ref: UTILISATEURS.id < MISES_EN_AVANT.modifiee_par_id [delete: restrict]
Ref: UTILISATEURS.id < STATISTIQUES_SITE.modifiee_par_id [delete: restrict]
Ref: UTILISATEURS.id < PARAMETRES_SITE.modifie_par_id [delete: restrict]
Ref: UTILISATEURS.id < NOTIFICATIONS_MEMBRES.creee_par_id [delete: restrict]
Ref: EVENEMENTS.id < NOTIFICATIONS_MEMBRES.evenement_id [delete: set null]
Ref: CONTENUS.id < NOTIFICATIONS_MEMBRES.contenu_id [delete: set null]

// Engagement
Ref: UTILISATEURS.id < DONS.traite_par_id [delete: restrict]
Ref: FICHIERS.id < PARTENAIRES.logo_id [delete: set null]
Ref: UTILISATEURS.id < DEMANDES_PARTENARIAT.traitee_par_id [delete: restrict]
Ref: PARTENAIRES.id < DEMANDES_PARTENARIAT.partenaire_id [delete: set null]

// Audit
Ref: UTILISATEURS.id < JOURNAL_AUDIT.acteur_id [delete: set null]

