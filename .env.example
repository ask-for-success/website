AFS_SECRET_KEY=replace-with-a-long-random-secret-key
AFS_DEBUG=1
AFS_ALLOWED_HOSTS=localhost,127.0.0.1
AFS_DB_NAME=afs
AFS_DB_USER=afs
AFS_DB_PASSWORD=afs
AFS_DB_HOST=database
AFS_DB_PORT=5432
AFS_DB_HOST_PORT=5433
# Development uses the console backend. Production will use the SMTP backend
# with Amazon SES credentials during the final infrastructure phase.
AFS_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AFS_DEFAULT_FROM_EMAIL=no-reply@askforsuccess.local
AFS_EMAIL_HOST=
AFS_EMAIL_PORT=587
AFS_EMAIL_HOST_USER=
AFS_EMAIL_HOST_PASSWORD=
AFS_EMAIL_USE_TLS=1
AFS_PUBLIC_WEB_URL=http://localhost:3000

# Self-hosted SeaweedFS storage. Replace all development secrets before production.
AFS_STORAGE_BACKEND=seaweedfs
AFS_STORAGE_S3_ENDPOINT_URL=http://seaweedfs:8333
AFS_STORAGE_PUBLIC_BASE_URL=http://localhost:8333/afs-public-media
AFS_STORAGE_ACCESS_KEY=afs-local-access
AFS_STORAGE_SECRET_KEY=replace-with-a-long-storage-secret
AFS_STORAGE_PUBLIC_BUCKET=afs-public-media
AFS_STORAGE_PRIVATE_BUCKET=afs-private-files
AFS_STORAGE_REGION=us-east-1
AFS_STORAGE_S3_HOST_PORT=8333
AFS_SEAWEEDFS_ADMIN_PASSWORD=replace-with-a-long-admin-password
